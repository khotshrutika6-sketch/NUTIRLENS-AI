# Set these as server-side environment variables in Vercel (not VITE_* variables).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
USDA_API_KEY=
# NUTRITION_API_KEY is also accepted as an alias for USDA_API_KEY.
# FIREBASE_API_KEY is optional; the existing public Firebase app config is shared with the backend.
